<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*"
             modules="AspNetCoreModuleV2"
             resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\STS.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess"
                  forwardWindowsAuthToken="false">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <!--
        Site default: SSL required, client cert is NEITHER required NOR
        negotiated. This is what allows /FederationMetadata and / to be
        reached without a client-cert prompt.

        The /wsfed endpoint opts in to per-URL TLS renegotiation via the
        <location path="wsfed"> override below. For that override to be
        honored (instead of producing a 404), the
        system.webServer/security/access section MUST be unlocked at the
        server level on the IIS host. To unlock it, run once as admin:

          %windir%\system32\inetsrv\appcmd.exe unlock config ^
            -section:"system.webServer/security/access"

        Per-URL renegotiation also requires that the HTTPS binding does
        NOT pre-negotiate the client cert. Verify with:
          netsh http show sslcert ipport=0.0.0.0:443
        and ensure "Negotiate Client Certificate : Disabled".
      -->
      <security>
        <access sslFlags="Ssl" />
      </security>
    </system.webServer>
  </location>

  <!--
    /wsfed: require an SSL client certificate for this URL only. IIS will
    perform an in-line TLS renegotiation when the URL is requested. The
    application enforces cert validity via Certificate authentication and
    Support/CertValidators.
  -->
  <location path="wsfed">
    <system.webServer>
      <security>
        <access sslFlags="Ssl, SslNegotiateCert, Ssl128" />
      </security>
    </system.webServer>
  </location>
</configuration>