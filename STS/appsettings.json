{
  "TokenLifetimeHours": 4,
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sts-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Issuer": "https://federation.lab.navintechnologies.com",
  "SignThumbprint": "594982B4F81809B40499565CEF9ACDFE",
  "RelyingParties": [
    "adfs.lab.navintechnologies.com"
  ],
  "SmartCard": {
    "ConfigPath": "Default.json"
  },
  "Environment": "NIPR",
  "CertificateValidation": {
    "ValidateChain": true,
    "RequireClientAuthEku": true,
    "RequireSmartCardLogonEku": true,
    "RequireDoDIssuer": false,
    "ValidateKeyUsage": true,
    "ValidateValidityPeriod": true,
    "RejectSelfSigned": true,
    "MinimumKeySize": 2048,
    "RequireSecureSignatureAlgorithm": true,
    "RequireTrustedRoot": false,
    "RequireUpnInSan": false
  },
  "FederationMetadata": {
    "EntityId": "https://federation.lab.navintechnologies.com",
    "PassiveRequestorEndpoint": "https://federation.lab.navintechnologies.com/wsfed",
    "OrganizationName": "Mini-STS",
    "OrganizationDisplayName": "Mini Security Token Service",
    "OrganizationUrl": "https://federation.lab.navintechnologies.com",
    "SupportedClaimTypes": [
      "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/upn",
      "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress",
      "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name",
      "http://schemas.microsoft.com/ws/2008/06/identity/claims/role",
      "http://schemas.microsoft.com/ws/2008/06/identity/claims/windowsaccountname",
      "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier"
    ]
  }
}
